(1|participant),
data = long_df_merged[ (is.na(long_df_merged$MOCA)|long_df_merged$MOCA>=26),])
summary(reg_aft_ind)
standardize_parameters(reg_aft_ind)
summary(reg_aft_ind)
anova(reg_aft_ind)
standardize_parameters(reg_aft_ind)
summary(reg_aft_ind)
standardize_parameters(mod_thouhgts_task_paths)
summary(mod_thouhgts_task_paths)
summary(reg_aft_ind)
